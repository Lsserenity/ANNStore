# Automatically normalize text files
* text=auto

# Linux scripts and build files must use LF
*.sh            text eol=lf
CMakeLists.txt  text eol=lf
*.cmake         text eol=lf
Makefile        text eol=lf

# Source and configuration files
*.cpp           text eol=lf
*.hpp           text eol=lf
*.c             text eol=lf
*.h             text eol=lf
*.py            text eol=lf
*.json          text eol=lf
*.md            text eol=lf
*.txt           text eol=lf

# Binary datasets, indexes, and artifacts
*.bin           binary
*.npy           binary
*.npz           binary
*.fvecs         binary
*.ivecs         binary
*.bvecs         binary
*.index         binary
*.so            binary
*.a             binary

